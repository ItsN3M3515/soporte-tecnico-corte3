    {
      "id": 3,
      "type": "stat",
      "title": "Errores 5xx (SLO < 1 %)",
      "description": "Peticiones con error del servidor / total, últimos 5 minutos.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
