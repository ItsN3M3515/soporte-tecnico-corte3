{
  "uid": "asistec-slo",
  "title": "AsisTec — SLO y operación",
  "tags": [
    "asistec",
    "slo"
  ],
  "timezone": "America/Bogota",
  "schemaVersion": 41,
  "version": 1,
  "refresh": "10s",
  "time": {
    "from": "now-30m",
    "to": "now"
  },
  "editable": false,
  "description": "SLO del Corte 2: p95 crear ≤ 500 ms, p95 cola ≤ 300 ms, errores < 1 %. Fuente: GET /metrics del backend.",
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "p95 crear solicitud (SLO ≤ 500 ms)",
      "description": "Últimos 5 minutos. Rojo = SLO incumplido.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "histogram_quantile(0.95, sum by (le) (rate(http_request_duration_seconds_bucket{metodo=\"POST\",ruta=\"/api/solicitudes\"}[5m])))",
          "legendFormat": ""
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 0.5
              }
            ]
          },
          "custom": {
            "thresholdsStyle": {
              "mode": "line+area"
            },
            "fillOpacity": 10
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "background",
        "graphMode": "area",
        "textMode": "value"
      }
    },
