# Copie este archivo como .env y cambie los valores:  cp .env.example .env
# El .env real NO se sube al repositorio (está en .gitignore).
# Todas las variables del sistema están aquí. La tabla completa (para qué sirve
# cada una, si es obligatoria y dónde se configura) está en docs/implementacion.md.

# --- Backend ---
# Obligatoria. Secreto para firmar los JWT. Genere uno largo y aleatorio con:
#   openssl rand -hex 32
JWT_SECRET=cambie-este-secreto-por-uno-aleatorio
# Minutos que tiene un técnico para aceptar antes de reasignar
MINUTOS_SIN_RESPUESTA=5
# Minutos en cola sin técnico antes de escalar al coordinador
MINUTOS_EN_COLA=10
# Cada cuánto revisa el programador de escalación (ms)
INTERVALO_ESCALACION_MS=30000

# --- Puertos en la máquina ---
# App web y API (por aquí entra todo el tráfico)
WEB_PORT=8080
# API directa, solo en 127.0.0.1 (Expo Go en desarrollo y pruebas de carga locales)
BACKEND_PORT=3000

# --- Observabilidad (solo con: docker compose --profile observabilidad up -d) ---
# Para activarla siempre en este servidor, descomente:
# COMPOSE_PROFILES=observabilidad
# Clave del usuario admin de Grafana. Genere una con:  openssl rand -base64 18
GRAFANA_ADMIN_PASSWORD=cambie-esta-clave
# Grafana escucha solo en 127.0.0.1 de esta máquina
GRAFANA_PORT=3002
